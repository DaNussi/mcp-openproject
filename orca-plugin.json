{
  "manifestVersion": 2,
  "id": "openproject",
  "name": "OpenProject MCP for Orca",
  "version": "0.2.0",
  "description": "Fork of IvanHa-dev/mcp-openproject: an OpenProject CE work package viewer for Orca that turns tickets into workspaces, plus a Rust MCP server with guarded writes.",
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "Illustration of the OpenProject MCP for Orca ticket panel using synthetic demo tasks"
  },
  "author": {
    "name": "DaNussi",
    "url": "https://github.com/DaNussi"
  },
  "repository": "https://github.com/DaNussi/mcp-openproject",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.274"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "openproject",
        "title": "OpenProject",
        "icon": {
          "path": "M5 3h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M6 8h4 M6 11h4 M6 14h2.5 M21 6a2 2 0 1 1-4 0a2 2 0 1 1 4 0 M21 18a2 2 0 1 1-4 0a2 2 0 1 1 4 0 M19 8v8 M13 12h2a4 4 0 0 0 4-4",
          "mode": "stroke"
        },
        "entry": "src/ui/main.ts",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "openproject.refresh",
        "title": "OpenProject: Refresh Projects & Tickets",
        "when": "global"
      },
      {
        "id": "openproject.clearCache",
        "title": "OpenProject: Clear Local Ticket Cache",
        "when": "global"
      }
    ],
    "statusBarItems": [
      {
        "id": "openproject-status",
        "text": "OpenProject",
        "icon": "branch",
        "tone": "neutral",
        "tooltip": "OpenProject CE connection status (click to refresh)",
        "command": "openproject.refresh"
      }
    ],
    "settings": [
      {
        "key": "baseUrl",
        "title": "OpenProject Base URL",
        "description": "Base URL of your OpenProject Community Edition instance (e.g. https://openproject.example.com).",
        "type": "string",
        "default": "",
        "placeholder": "https://openproject.example.com"
      },
      {
        "key": "readProjects",
        "title": "Read Projects Allowlist",
        "description": "Comma-separated project identifiers or '*' allowed for reading (maps to OPENPROJECT_READ_PROJECTS).",
        "type": "string",
        "default": "*",
        "placeholder": "* or my-project-slug"
      },
      {
        "key": "writeProjects",
        "title": "Write Projects Allowlist",
        "description": "Comma-separated project identifiers or '*' allowed for guarded writes (maps to OPENPROJECT_WRITE_PROJECTS).",
        "type": "string",
        "default": "*",
        "placeholder": "* or my-project-slug"
      },
      {
        "key": "defaultAgent",
        "title": "Default Agent for Tickets",
        "description": "Agent CLI to start when launching work on an OpenProject work package.",
        "type": "string",
        "default": "codex",
        "enum": [
          "antigravity",
          "agy",
          "codex",
          "claude",
          "gemini",
          "opencode",
          "kilocode",
          "cursor-agent",
          "droid",
          "omp",
          "pi",
          "grok"
        ],
        "enumLabels": [
          "Antigravity (agy)",
          "Antigravity CLI (agy)",
          "Codex",
          "Claude Code",
          "Gemini CLI",
          "OpenCode",
          "KiloCode",
          "Cursor Agent",
          "Droid",
          "OMP",
          "Pi",
          "Grok"
        ]
      },
      {
        "key": "mcpBinaryPath",
        "title": "Rust MCP Binary Path",
        "description": "Executable name or path for the Rust mcp-openproject stdio server.",
        "type": "string",
        "default": "mcp-openproject",
        "placeholder": "mcp-openproject"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "workspace:create"
    },
    {
      "kind": "workspace:write"
    }
  ]
}
